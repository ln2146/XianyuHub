# ================= 鱼塘管家部署配置 =================
# 复制为 .env 后修改。带“必填”的项不能留空。

# ---------- 安全（必填） ----------
# 生成方式：python3 -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
# 32 字节 base64，用于加密 Cookie / 卡密，丢失后已加密的数据无法恢复，请妥善备份
# 生成方式：python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
CREDENTIAL_MASTER_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Docker 部署经 Caddy 反向代理访问，本机免登录不会生效，始终需要账号密码
LOCAL_AUTH=false
POSTGRES_PASSWORD=

# ---------- 访问 ----------
# 监听地址：127.0.0.1 仅本机；0.0.0.0 局域网可访问
WEB_BIND=127.0.0.1
WEB_PORT=8080
# 填写域名可自动启用 HTTPS（需要 80/443 端口可从公网访问）
SITE_ADDRESS=:80
CORS_ORIGINS=["http://localhost:8080"]

# ---------- 大模型 ----------
# anthropic（默认）或 openai_compatible（Qwen / DeepSeek / 本地 vLLM 等）
LLM_DEFAULT_PROVIDER=anthropic
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_VISION=claude-opus-5-5
LLM_MODEL_CHAT=claude-opus-5-5
LLM_MODEL_FAST=claude-opus-5-5
LLM_DAILY_TOKEN_BUDGET=0

# ---------- 风控（保守默认值） ----------
GUARD_RATE_MULTIPLIER=1.0
GUARD_SEARCH_PER_MIN=6
GUARD_MESSAGE_PER_MIN=20
GUARD_PUBLISH_PER_5MIN=1
GUARD_COOLDOWN_BASE_SECONDS=1800

# ---------- 浏览器通道（可选） ----------
WITH_BROWSER=false
BROWSER_ENABLED=false
