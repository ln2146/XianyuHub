# ---------- 基础 ----------
APP_ENV=development
BIND_HOST=127.0.0.1
APP_PORT=8000
APP_SECRET_KEY=change-me
# 32 字节 base64：python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
CREDENTIAL_MASTER_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------- 存储 ----------
# 默认 SQLite；生产建议 PostgreSQL：postgresql+asyncpg://xianyu:xianyu@postgres:5432/xianyuhub
# DATABASE_URL=
# 为空时使用进程内实现（单机模式）
REDIS_URL=

# ---------- 大模型 ----------
# 推荐在管理台「模型接入」里配置：支持多套配置随时切换、测试连通性、拉取模型列表。
# 下面的值只在管理台没有任何启用配置时兜底使用（首次启动会自动把这里的值落成一套接入配置）。
# anthropic（默认，使用官方 SDK）或 openai_compatible（Qwen / DeepSeek / 本地 vLLM 等）
LLM_DEFAULT_PROVIDER=anthropic
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_VISION=claude-opus-5-5
LLM_MODEL_CHAT=claude-opus-5-5
LLM_MODEL_FAST=claude-opus-5-5
LLM_DAILY_TOKEN_BUDGET=0

# ---------- 风控 ----------
GUARD_SEARCH_PER_MIN=6
GUARD_MESSAGE_PER_MIN=20
GUARD_PUBLISH_PER_5MIN=1
GUARD_COOLDOWN_BASE_SECONDS=1800
